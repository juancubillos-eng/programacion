class Producto:
    def __init__(self, nombre, precio, cantidad):
        if not nombre.strip():
            raise ValueError("El nombre del producto no puede estar vacío.")
        if float(precio) < 0:
            raise ValueError("El precio debe ser mayor o igual a cero.")
        if int(cantidad) < 0:
            raise ValueError("La cantidad debe ser mayor o igual a cero.")
            
        self.nombre = str(nombre).strip()
        self.precio = float(precio)
        self.cantidad = int(cantidad)

    def actualizar_precio(self, nuevo_precio):
        if float(nuevo_precio) < 0:
            raise ValueError("El precio debe ser mayor o igual a cero.")
        self.precio = float(nuevo_precio)

    def actualizar_cantidad(self, nueva_cantidad):
        if int(nueva_cantidad) < 0:
            raise ValueError("La cantidad debe ser mayor o igual a cero.")
        self.cantidad = int(nueva_cantidad)

    def calcular_valor_total(self):
        return self.precio * self.cantidad

    def __str__(self):
        return f"Producto: {self.nombre.capitalize():<15} | Precio: ${self.precio:8.2f} \vert{} Cantidad: {self.cantidad:<5} \vert{} Total:${self.calcular_valor_total():8.2f}"


class Inventario:
    def __init__(self):
        self.productos = []

    def agregar_producto(self, producto):
        self.productos.append(producto)
        print(f"[ÉXITO] Producto '{producto.nombre}' agregado correctamente.")

    def buscar_producto(self, nombre):
        nombre_busqueda = str(nombre).strip().lower()
        for producto in self.productos:
            if producto.nombre.lower() == nombre_busqueda:
                return producto
        return None

    def calcular_valor_inventario(self):
        return sum(producto.calcular_valor_total() for producto in self.productos)

    def listar_productos(self):
        if not self.productos:
            print("\n[INFO] El inventario está vacío actualmente.")
        else:
            print("\n" + "="*70)
            print("LISTA DE PRODUCTOS EN INVENTARIO")
            print("="*70)
            for producto in self.productos:
                print(producto)
            print("="*70)


